# ==========================================================
# Reviews Agent — шаблон переменных окружения
# Скопировать в .env и заполнить реальными значениями.
# .env под gitignore и в репозиторий не попадает.
# ==========================================================

# --- Postgres: база reviews на VPS.
#     Порт 5432 наружу не проброшен, ходим через SSH-туннель,
#     поэтому host — localhost, а не IP сервера. ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reviews
POSTGRES_USER=reviews_app
POSTGRES_PASSWORD=

# --- Anthropic API: Haiku 4.5 (классификация) + Sonnet 5 (генерация) ---
ANTHROPIC_API_KEY=

# --- Telegram: бот kinetica_solutions_bot для HITL-карточек ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LangGraph: ограничивает десериализацию чекпоинтов
#     известными типами. Требование безопасности
#     langgraph-checkpoint-postgres 3.1.0. ---
LANGGRAPH_STRICT_MSGPACK=true