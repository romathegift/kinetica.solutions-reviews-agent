# ==========================================================
# Reviews Agent — шаблон переменных окружения
# Скопировать в .env и заполнить реальными значениями.
# .env под gitignore и в репозиторий не попадает.
#
# ВАЖНО для прода: в контейнер конфиг приходит НАСТОЯЩИМИ
# переменными окружения (compose env_file), а не смонтированным
# .env — config.py ищет .env рядом с пакетом и после неredactable
# установки его там не будет.
# ==========================================================

# --- Клиент, под которого работает этот деплой.
#     Один деплой = один клиент. Есть значение по умолчанию,
#     переопределять нужно только при смене клиента. ---
CLIENT_ID=medovyi_ranok

# --- Postgres: база reviews на VPS.
#     Локально порт 5432 наружу не проброшен, ходим через
#     SSH-туннель, поэтому host — localhost.
#     В контейнере на VPS host — postgres (имя контейнера
#     в сети n8n_default), туннель не нужен. ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reviews
POSTGRES_USER=reviews_app
POSTGRES_PASSWORD=

# --- Anthropic API: Haiku 4.5 (классификация) + Sonnet 5 (генерация) ---
ANTHROPIC_API_KEY=

# --- Telegram: бот kinetica_solutions_bot для HITL-карточек ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram webhook.
#     BASE_URL — только схема и хост, БЕЗ пути; полный URL
#     собирается в config.py как свойство telegram_webhook_url.
#     Пустой BASE_URL = вебхук не настроен: сервис стартует,
#     setWebhook не вызывается (рабочий режим для локальной отладки).
#     SECRET проверяется в заголовке X-Telegram-Bot-Api-Secret-Token.
#     Telegram запрещает в секрете всё, кроме A-Za-z0-9_- —
#     иначе setWebhook падает на старте с BadRequest. ---
TELEGRAM_WEBHOOK_BASE_URL=https://reviews.kinetica.solutions
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# --- Адрес, который слушает приложение.
#     Используется только при локальном запуске через
#     scripts/run_webhook.py. В контейнере команда запуска —
#     голый uvicorn с явными --host/--port, и эти переменные
#     не читаются. ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- LangGraph: ограничивает десериализацию чекпоинтов
#     известными типами. Требование безопасности
#     langgraph-checkpoint-postgres 3.1.0. ---
LANGGRAPH_STRICT_MSGPACK=true